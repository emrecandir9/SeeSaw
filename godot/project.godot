; Godot 4.7.2-stable. Owner: Gloria.
config_version=5

[application]
config/name="SeeSaw G1"
run/main_scene="res://scenes/MainXR.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1100
window/size/viewport_height=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.065, 1)

[xr]
openxr/enabled=false
openxr/default_action_map="res://openxr_action_map.tres"
shaders/enabled=true
